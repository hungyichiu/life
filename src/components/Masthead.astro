---
import { SECTIONS, SITE, formatDate, url } from '../lib/site';

interface Props { home: boolean; active?: string; issue: number; issueDate?: Date }
const { home, active, issue, issueDate } = Astro.props;
const Plate = home ? 'h1' : 'div';
---
<header class="masthead" id="masthead">
  <div class="topline"><span>第 {issue} 期</span><span>台灣．生活版</span><span>定價：一杯愛樂壓</span></div>
  <Plate class="nameplate"><a href={url()}>{SITE.name}<small>{SITE.nameZh}</small></a></Plate>
  {home && <span class="hint" id="hint">↖ 滑鼠在這裡亂晃看看</span>}
  <div class="dateline">
    <span>{issueDate ? formatDate(issueDate, true) : '創刊準備中'}</span>
    <nav aria-label="分版">
      <a href={url()} class:list={{ on: home }}>頭版</a>
      {SECTIONS.map((s) => <a href={url(`${s.key}/`)} class:list={{ on: active === s.key }}>{s.nav}</a>)}
    </nav>
    <button class="theme-btn" id="themeBtn" type="button">夜間版 ☾</button>
  </div>
</header>

<script>
  const btn = document.getElementById('themeBtn')!;
  const root = document.documentElement;
  const paint = () => { btn.textContent = root.dataset.theme === 'dark' ? '日間版 ☀' : '夜間版 ☾'; };
  paint();
  btn.addEventListener('click', () => {
    const dark = root.dataset.theme === 'dark';
    if (dark) delete root.dataset.theme; else root.dataset.theme = 'dark';
    localStorage.setItem('chris-daily-theme', dark ? 'light' : 'dark');
    paint();
    document.dispatchEvent(new Event('themechange'));
  });
</script>
