---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import RedPen from '../components/RedPen.astro';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  active?: string;
  issue: number;
  issueDate?: Date;
  keywords?: string[];
  article?: { published: Date };
}
const { title, description = SITE.description, home = false, active, issue, issueDate, keywords, article } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name} ${SITE.nameZh}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og-image.png'), Astro.site);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords?.length ? <meta name="keywords" content={keywords.join(', ')} /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('rss.xml')} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {article ? <meta property="article:published_time" content={article.published.toISOString()} /> : null}
    <script is:inline>
      // 先套用夜間版設定，避免閃一下白底
      if (localStorage.getItem('chris-daily-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&family=Playfair+Display:wght@700;900&family=Iansui&display=swap" rel="stylesheet" />
  </head>
  <body class={home ? 'home' : 'inner'}>
    <div class="wrap">
      <Masthead home={home} active={active} issue={issue} issueDate={issueDate} />
      <slot />
      <footer>
        © {new Date().getUTCFullYear()} {SITE.name}　｜　本報不定期出刊　｜　技術文章請見 <a href={SITE.techSite}>SAP 開發技術筆記</a>
      </footer>
    </div>
    <RedPen />
  </body>
</html>
