---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getArticles, headlineHtml, readingMinutes, sectionOf, url } from '../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, latest: articles[0], count: articles.length } }));
}
const { entry, latest, count } = Astro.props;
const { Content } = await render(entry);
const { title, description, created, tags, keywords } = entry.data;
const section = sectionOf(entry);
---
<Base title={title} description={description} active={section?.key} issue={count} issueDate={latest.data.created} keywords={keywords} article={{ published: created }}>
  <main>
    <article class="article">
      {section && <div class="kicker">{section.name}</div>}
      <h1 class="headline" set:html={headlineHtml(title)} />
      {description && <p class="dek">{description}</p>}
      <div class="byline">本報特派員 Chris　｜　{formatDate(created)}　｜　閱讀時間約 {readingMinutes(entry.body)} 分鐘</div>
      <Content />
      <div class="end">— 完 —</div>
      <div class="after">
        <span>
          {section && <>分類：<a href={url(`${section.key}/`)}>{section.name}</a></>}
          {tags.length > 0 && <>　標籤：{tags.join('、')}</>}
        </span>
        <a href={url()}>← 回頭版</a>
      </div>
    </article>
  </main>
</Base>
